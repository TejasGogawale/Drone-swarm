    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  REALISTIC 3D RESCUE & STRANDED VEHICLES                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- 1. Rescue Ambulance (East=11, North=-8 -> NED N=-8, E=11) -->
    <model name="rescue_ambulance">
      <static>true</static>
      <pose>11 -8 0 0 0 0.45</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <scale>0.0254 0.0254 0.0254</scale>
