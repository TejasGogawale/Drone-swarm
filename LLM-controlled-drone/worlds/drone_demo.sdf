<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="drone_demo">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.62 0.60 0.58 1</ambient>
      <background>0.72 0.78 0.85 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -24 20 0 0.62 1.570796</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Main directional sunlight -->
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1.25</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.95 0.91 0.85 1</diffuse>
      <specular>0.30 0.28 0.25 1</specular>
    </light>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  POST-EARTHQUAKE GROUND & CRACKED ASPHALT STREETS                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="earth_base">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.36 0.34 0.31 1</ambient>
            <diffuse>0.44 0.41 0.37 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- Central Disaster Plaza & Intersecting Asphalt Roads -->
        <visual name="road_ew">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><box><size>140 12 0.02</size></box></geometry>
          <material>
            <ambient>0.20 0.20 0.22 1</ambient>
            <diffuse>0.25 0.25 0.27 1</diffuse>
          </material>
        </visual>
        <visual name="road_ns">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry><box><size>12 140 0.02</size></box></geometry>
          <material>
            <ambient>0.20 0.20 0.22 1</ambient>
            <diffuse>0.25 0.25 0.27 1</diffuse>
          </material>
        </visual>
        <visual name="central_plaza_pavement">
          <pose>0 0 0.008 0 0 0</pose>
          <geometry><box><size>34 34 0.015</size></box></geometry>
          <material>
            <ambient>0.32 0.31 0.29 1</ambient>
            <diffuse>0.38 0.37 0.35 1</diffuse>
          </material>
        </visual>
        <!-- Helipad / Drone Home Pad at (0,0) -->
        <visual name="helipad_circle">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><cylinder><radius>1.8</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.28 0.30 1</ambient>
            <diffuse>0.30 0.35 0.38 1</diffuse>
          </material>
        </visual>
        <visual name="helipad_ring">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>1.5</radius><length>0.012</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.65 0.10 1</ambient>
            <diffuse>0.95 0.75 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  REALISTIC 3D COLLAPSED BUILDINGS (OUTER RING r = 35..42m)          -->
    <!--  Safe outer perimeter: drone orbits inside r <= 20m collision-free! -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- 1. Collapsed Fire Station (NE Sector: East=32, North=26 -> NED N=26, E=32) -->
    <model name="collapsed_fire_station_ne">
      <static>true</static>
      <pose>32 26 0 0 0 -0.65</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file:///home/tushar/.gz/fuel/fuel.gazebosim.org/openrobotics/models/collapsed fire station/3/meshes/collapsed_fire_station.dae</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/tushar/.gz/fuel/fuel.gazebosim.org/openrobotics/models/collapsed fire station/3/meshes/collapsed_fire_station.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 2. Collapsed Police Station (NW Sector: East=-32, North=26 -> NED N=26, E=-32) -->
    <model name="collapsed_police_station_nw">
      <static>true</static>
      <pose>-32 26 0 0 0 0.55</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file:///home/tushar/.gz/fuel/fuel.gazebosim.org/openrobotics/models/collapsed police station/3/meshes/collapsed_police_station.dae</uri>
            </mesh>
