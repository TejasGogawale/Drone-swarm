    <!-- 6. Collapsed Police Station South (South Sector: East=0, North=-36 -> NED N=-36, E=0) -->
    <model name="collapsed_police_station_south">
      <static>true</static>
      <pose>0 -36 0 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file:///home/tushar/.gz/fuel/fuel.gazebosim.org/openrobotics/models/collapsed police station/3/meshes/collapsed_police_station.dae</uri>
            </mesh>
