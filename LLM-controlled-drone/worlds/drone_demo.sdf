    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  REALISTIC 3D HUMAN MODELS: STANDING, WALKING & LYING VICTIMS      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- A. WALKING HUMAN SURVIVORS (Animated 3D Skeletal Mesh) -->
    <!-- Walking Survivor 1 (NE Plaza: East=6..10, North=8 -> NED N=8, E=6..10) -->
    <actor name="walking_survivor_1">
      <pose>6 8 1.0 0 0 0</pose>
      <skin>
        <filename>file:///home/tushar/.gz/fuel/fuel.gazebosim.org/mingfei/models/actor/1/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>file:///home/tushar/.gz/fuel/fuel.gazebosim.org/mingfei/models/actor/1/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>6 8 1.0 0 0 0</pose></waypoint>
          <waypoint><time>6</time><pose>10 8 1.0 0 0 0</pose></waypoint>
          <waypoint><time>7</time><pose>10 8 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>13</time><pose>6 8 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>14</time><pose>6 8 1.0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Walking Survivor 2 (SW Plaza: East=-6..-10, North=-8 -> NED N=-8, E=-6..-10) -->
    <actor name="walking_survivor_2">
      <pose>-6 -8 1.0 0 0 3.14159</pose>
      <skin>
        <filename>file:///home/tushar/.gz/fuel/fuel.gazebosim.org/mingfei/models/actor/1/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>file:///home/tushar/.gz/fuel/fuel.gazebosim.org/mingfei/models/actor/1/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>-6 -8 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>6</time><pose>-10 -8 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>7</time><pose>-10 -8 1.0 0 0 0</pose></waypoint>
          <waypoint><time>13</time><pose>-6 -8 1.0 0 0 0</pose></waypoint>
          <waypoint><time>14</time><pose>-6 -8 1.0 0 0 3.14159</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- B. STANDING HUMAN SURVIVORS (Photorealistic Textured 3D Meshes) -->
    <!-- Standing Survivor Male 1 (East=4, North=10 -> NED N=10, E=4) -->
    <model name="standing_survivor_male_1">
      <static>true</static>
      <pose>4 10 0 0 0 -1.9</pose>
