    <!-- 5. Collapsed House North (North Sector: East=0, North=36 -> NED N=36, E=0) -->
    <model name="collapsed_house_north">
      <static>true</static>
      <pose>0 36 0 0 0 3.14159</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
