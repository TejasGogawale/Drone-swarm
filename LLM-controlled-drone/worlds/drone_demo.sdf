    <!-- 4. Collapsed House SW (SW Sector: East=-30, North=-24 -> NED N=-24, E=-30) -->
    <model name="collapsed_house_sw">
      <static>true</static>
      <pose>-30 -24 0 0 0 -0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <scale>1.5 1.5 1.5</scale>
              <uri>file:///home/tushar/.gz/fuel/fuel.gazebosim.org/openrobotics/models/collapsed house/4/meshes/collapsed_house.dae</uri>
